<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             x:Class="Lockpick.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <Grid RowDefinitions="Auto,*,*" RowSpacing="12">

    <Border Grid.Row="0" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
        <TextBlock Grid.ColumnSpan="3" Classes="caption" Text="MONITOR" />
        <TextBlock Grid.Row="1" Classes="label" Text="Polling" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding PollStats}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Classes="label" Text="Timer" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding TimerInfo}" />
        <TextBlock Grid.Row="3" Classes="label" Text="Log file" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding LogFile}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Classes="label" Text="Recording" />
        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding RecordingStatus}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="2" Spacing="6" VerticalAlignment="Center">
          <Button Content="Start recording" Command="{Binding StartRecordingCommand}" HorizontalAlignment="Stretch" />
          <Button Content="Stop recording" Command="{Binding StopRecordingCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="PROFILE FIELDS (RAW)" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="140,100,110,100,*,100" Margin="4,0,4,4">
          <TextBlock Classes="label" Text="Field" />
          <TextBlock Grid.Column="1" Classes="label" Text="Address" />
          <TextBlock Grid.Column="2" Classes="label" Text="Type" />
          <TextBlock Grid.Column="3" Classes="label" Text="Verification" />
          <TextBlock Grid.Column="4" Classes="label" Text="Value" />
          <TextBlock Grid.Column="5" Classes="label" Text="Read" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding RawFields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RawFieldRow">
                <Grid ColumnDefinitions="140,100,110,100,*,100" Margin="4,2">
                  <TextBlock Classes="mono" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Address}" />
                  <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Type}" />
                  <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Verification}" Classes.inactive="{Binding !IsTrusted}" />
                  <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Value}" />
                  <TextBlock Grid.Column="5" Classes="mono" Text="{Binding Status}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="LOG" />
        <ListBox ItemsSource="{Binding LogRows}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4,2" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRow">
              <Grid ColumnDefinitions="96,96,*">
                <TextBlock Classes="mono" Text="{Binding Time}" Foreground="{StaticResource LpMutedBrush}" FontSize="11.5" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Level}" Classes.warning="{Binding IsWarning}" FontSize="11.5" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Classes.warning="{Binding IsWarning}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
