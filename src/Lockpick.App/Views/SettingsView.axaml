<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             x:Class="Lockpick.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="GAME INSTALLATION" />
          <TextBlock Text="{Binding DetectedInstall}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="Executable override (leave empty to use the detected GOG install)" />
          <TextBox Text="{Binding GameExecutablePath}" PlaceholderText="e.g. G:\GOG Games\Resident Evil\ResidentEvil.exe" FontFamily="{StaticResource LpMono}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check build" Command="{Binding CheckInstalledBuildCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Foreground="{StaticResource LpMutedBrush}" />
          </StackPanel>
          <SelectableTextBlock Classes="mono" Text="{Binding BuildCheckResult}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="VERSION PROFILES" />
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Built-in profiles are embedded. Additional or overriding profiles (*.json) are loaded at startup from:" />
          <SelectableTextBlock Classes="mono" Text="{Binding ProfileDirectory}" />
          <TextBlock Classes="label" Text="Loaded" />
          <SelectableTextBlock Classes="mono" Text="{Binding LoadedProfiles}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
