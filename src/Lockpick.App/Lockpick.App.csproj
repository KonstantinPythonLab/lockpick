<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Lockpick.App</RootNamespace>
    <AssemblyName>Lockpick</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Lockpick Trainer desktop application.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lockpick.Core\Lockpick.Core.csproj" />
    <ProjectReference Include="..\Lockpick.Platform.Windows\Lockpick.Platform.Windows.csproj" />
    <ProjectReference Include="..\Lockpick.GameAdapter.RE1\Lockpick.GameAdapter.RE1.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lockpick.Tests" />
  </ItemGroup>
</Project>
